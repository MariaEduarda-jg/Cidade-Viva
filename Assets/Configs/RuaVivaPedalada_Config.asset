  m_Name: RuaVivaPedalada_Config
  m_EditorClassIdentifier: Assembly-CSharp::PedaladaConfig
  trechoDoCiclista: Pessoa que conduz uma bicicleta
  trechoDoCapacete: "deve usar equipamentos de seguran\xE7a, como capacete"
  trechoDaCiclovia: "incluindo o uso de ciclovia ou ciclofaixa quando dispon\xEDveis"
  trechoDoAcumulo: "muitos ve\xEDculos acumulados na via"
  trechoDaPassagem: "atrapalha a passagem de outros ve\xEDculos"
  trechoDaCalcada: destinada para a passagem de pedestres ou animais
  trechoDaViaSeparada: "est\xE1 em via separada do tr\xE2nsito dos ve\xEDculos"
  trechoDoLadoDosCarros: "est\xE1 ao lado da via dos outros ve\xEDculos"
  roteiros:
  - titulo: Passeio no parque
    texto: "O parque reabriu depois da enchente, com ciclovia nova! Antes de pedalar, escolha o que vai na cabe\xE7a."
    novidade: 'Novo: o capacete e a ciclovia, que muda de lado.'
    coisasDaCabeca:
    - capacete
    - bone
    trechos:
    - esquerda: 0
      meio: 1
      direita: 4
      comprimento: 30
      parque: 1
      obstaculo: 0
      engarrafamento: 0
      aviso: 
    - esquerda: 0
      meio: 4
      direita: 1
      comprimento: 36
      parque: 1
      obstaculo: 0
      engarrafamento: 0
      aviso: A ciclovia vai pra direita!
    - esquerda: 4
      meio: 1
      direita: 0
      comprimento: 36
      parque: 1
      obstaculo: 0
      engarrafamento: 0
      aviso: A ciclovia volta pro meio!
    - esquerda: 1
      meio: 4
      direita: 0
      comprimento: 36
      parque: 1
      obstaculo: 0
      engarrafamento: 0
      aviso: Agora a ciclovia vai pra esquerda!
    - esquerda: 1
      meio: 0
      direita: 0
      comprimento: 30
      parque: 1
      obstaculo: 0
      engarrafamento: 0
      aviso: "Quase l\xE1: o mirante do parque!"
    recadoDeChegada: Chegamos ao mirante! De capacete e na ciclovia o tempo todo.
  - titulo: "P\xE3o fresquinho"
    texto: "A padaria abriu de novo! O caminho \xE9 pela rua: em parte dela tem ciclofaixa, pintada de vermelho, ao lado dos carros."
    novidade: 'Novo: a ciclofaixa e os trechos sem ciclofaixa.'
    coisasDaCabeca:
    - capacete
    - bone
    - chapeu_de_festa
    trechos:
    - esquerda: 3
      meio: 3
      direita: 2
      comprimento: 30
      parque: 0
      obstaculo: 0
      engarrafamento: 0
      aviso: 
    - esquerda: 3
      meio: 3
      direita: 2
      comprimento: 30
      parque: 0
      obstaculo: 0
      engarrafamento: 0
      aviso: 
    - esquerda: 3
      meio: 3
      direita: 4
      comprimento: 36
      parque: 0
      obstaculo: 0
      engarrafamento: 0
      aviso: "A ciclofaixa acabou: pedale na rua, perto da cal\xE7ada."
    - esquerda: 3
      meio: 3
      direita: 2
      comprimento: 36
      parque: 0
      obstaculo: 0
      engarrafamento: 0
      aviso: Tem ciclofaixa de novo! Volte pra ela.
    - esquerda: 3
      meio: 3
      direita: 4
      comprimento: 36
      parque: 0
      obstaculo: 1
      engarrafamento: 0
      aviso: Sem ciclofaixa de novo. Cuidado com o buraco!
    - esquerda: 3
      meio: 3
      direita: 2
      comprimento: 30
      parque: 0
      obstaculo: 0
      engarrafamento: 0
      aviso: "Ciclofaixa! A padaria \xE9 logo ali."
    recadoDeChegada: "Chegamos na padaria! P\xE3o fresquinho pra fam\xEDlia."
  - titulo: "A festa da reconstru\xE7\xE3o"
    texto: Hoje tem festa! Atravesse o parque e a avenida antes do tempo acabar.
    novidade: "Novo: o engarrafamento e o rel\xF3gio."
    coisasDaCabeca:
    - capacete
    - chapeu_de_festa
    - bone
    trechos:
    - esquerda: 0
      meio: 1
      direita: 4
      comprimento: 30
      parque: 1
      obstaculo: 0
      engarrafamento: 0
      aviso: 
    - esquerda: 1
      meio: 4
      direita: 0
      comprimento: 30
      parque: 1
      obstaculo: 0
      engarrafamento: 0
      aviso: A ciclovia vai pra esquerda!
    - esquerda: 3
      meio: 3
      direita: 2
      comprimento: 36
      parque: 0
      obstaculo: 0
      engarrafamento: 0
      aviso: "Saindo do parque: agora \xE9 ciclofaixa, \xE0 direita."
    - esquerda: 3
      meio: 3
      direita: 4
      comprimento: 30
      parque: 0
      obstaculo: 1
      engarrafamento: 0
      aviso: 'Sem ciclofaixa: pedale na rua. Olhe o buraco!'
    - esquerda: 3
      meio: 3
      direita: 2
      comprimento: 50
      parque: 0
      obstaculo: 0
      engarrafamento: 1
      aviso: Ciclofaixa de novo! E olhe a avenida...
    - esquerda: 3
      meio: 3
      direita: 2
      comprimento: 30
      parque: 0
      obstaculo: 0
      engarrafamento: 0
      aviso: "A festa \xE9 logo ali!"
    recadoDeChegada: "Chegamos na festa da reconstru\xE7\xE3o!"
