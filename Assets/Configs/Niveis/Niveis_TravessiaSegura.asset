    quantidadeDeObstaculos: 3
    tempoEmSegundos: 0
    quantidadeDeItens: 0
    errosPermitidos: 2
    regrasExtras:
    - comecar_fora_da_faixa
    - ciclista
    extras:
    - nome: intervaloDeCarros
      valor: 4
    estrelas:
      medida: 4
