    - nome: tempoVerde
      valor: 6
    - nome: tempoVermelho
      valor: 6
    estrelas:
      medida: 4
      para2Estrelas: 2
      para3Estrelas: 3
  - objetivo: "Tr\xEAs pistas e uma ciclovia, sem sem\xE1foro. Olhe bem!"
